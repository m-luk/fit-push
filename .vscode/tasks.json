{
    // "process" tasks start Python directly, so they work whatever the
    // default terminal is (PowerShell, cmd, Git Bash, WSL).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "fit-git: run",
            "detail": "Start the app on http://127.0.0.1:8000 (sets up .venv on first run)",
            "type": "process",
            "command": "python3",
            "windows": { "command": "python" },
            "args": ["${workspaceFolder}/scripts/run.py"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "fit-git: run (auto-reload)",
            "detail": "Start the app and restart it when Python files change",
            "type": "process",
            "command": "python3",
            "windows": { "command": "python" },
            "args": ["${workspaceFolder}/scripts/run.py", "--reload"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "fit-git: tests",
            "detail": "Run the pytest suite (installs dev requirements on first run)",
            "type": "process",
            "command": "python3",
            "windows": { "command": "python" },
            "args": ["${workspaceFolder}/scripts/run.py", "--tests"],
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "fit-git: run (core only)",
            "detail": "Start the app without any modules",
            "type": "process",
            "command": "python3",
            "windows": { "command": "python" },
            "args": ["${workspaceFolder}/scripts/run.py", "--core-only"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "fit-git: lint + types",
            "detail": "ruff check, ruff format --check, ty check, module rules",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
            "args": ["-c", "import subprocess, sys; sys.exit(max(subprocess.call(c) for c in ([sys.executable, \"-m\", \"ruff\", \"check\", \".\"], [sys.executable, \"-m\", \"ruff\", \"format\", \"--check\", \".\"], [sys.executable, \"-m\", \"ty\", \"check\"], [sys.executable, \"scripts/modules.py\", \"check\"])))"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
